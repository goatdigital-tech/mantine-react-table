{
  "version": "3.0.0-beta.1",
  "license": "MIT",
  "name": "mantine-react-table",
  "description": "A fully featured Mantine implementation of TanStack React Table V9, written from the ground up in TypeScript.",
  "author": "Kevin Vandy",
  "keywords": [
    "react-table",
    "mantine",
    "tanstack table",
    "data table",
    "data grid"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/goatdigital-tech/mantine-react-table"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kevinvandy"
  },
  "homepage": "https://www.mantine-react-table.com/",
  "bugs": {
    "url": "https://github.com/goatdigital-tech/mantine-react-table/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.esm.mjs",
  "types": "dist/index.esm.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.esm.d.mts",
        "default": "./dist/index.esm.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./locales/*": {
      "import": {
        "types": "./locales/*/index.esm.d.mts",
        "default": "./locales/*/index.esm.mjs"
      },
      "require": {
        "types": "./locales/*/index.d.cts",
        "default": "./locales/*/index.cjs"
      }
    },
    "./locales/*/index.cjs": {
      "types": "./locales/*/index.d.cts",
      "default": "./locales/*/index.cjs"
    },
    "./locales/*/index.esm.mjs": {
      "types": "./locales/*/index.esm.d.mts",
      "default": "./locales/*/index.esm.mjs"
    },
    "./locales/*/package.json": "./locales/*/package.json",
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "locales",
    "styles.css",
    "src"
  ],
  "size-limit": [
    {
      "path": "dist/index.cjs",
      "limit": "80 KB"
    },
    {
      "path": "dist/index.esm.mjs",
      "limit": "75 KB"
    }
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm lib:build",
    "build-locales": "pnpm lib:build-locales",
    "build-lib": "pnpm lib:build-lib",
    "dev": "pnpm lib:dev",
    "lib:build": "pnpm build-lib && pnpm build-locales",
    "lib:build-locales": "node build-locales.mjs",
    "lib:build-lib": "rm -rf dist && rollup -c rollup.config.mjs && size-limit",
    "lib:dev": "rollup -c rollup.config.mjs --watch",
    "lint": "eslint .",
    "size": "size-limit",
    "storybook": "pnpm storybook:dev",
    "storybook:build": "storybook build",
    "storybook:dev": "storybook dev -p 6007",
    "storybook:serve": "serve storybook-static --listen 6008 --no-clipboard",
    "test:types": "pnpm test:types:ts6 && pnpm test:types:ts7",
    "test:types:install": "pnpm --dir tests/consumer install --ignore-workspace --frozen-lockfile",
    "test:types:ts6": "pnpm --dir tests/consumer check:ts6",
    "test:types:ts7": "pnpm --dir tests/consumer check:ts7",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@babel/core": "^7.25.8",
    "@babel/preset-react": "^7.25.7",
    "@faker-js/faker": "^9.0.3",
    "@mantine/core": "9.5.1",
    "@mantine/dates": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@storybook/addon-a11y": "^8.6.17",
    "@storybook/addon-essentials": "^8.6.17",
    "@storybook/addon-interactions": "^8.6.17",
    "@storybook/addon-links": "^8.6.17",
    "@storybook/addon-storysource": "^8.6.17",
    "@storybook/blocks": "^8.6.17",
    "@storybook/preview-api": "^8.6.17",
    "@storybook/react": "^8.6.17",
    "@storybook/react-vite": "^8.6.17",
    "@storybook/testing-library": "^0.2.2",
    "@types/node": "^22.7.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.5.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "eslint": "^8.57.0",
    "eslint-plugin-perfectionist": "^3.8.0",
    "mantine-contextmenu": "^8.3.13",
    "postcss": "^8.4.47",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prop-types": "^15.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rollup": "^4.24.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^2.1.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "serve": "^14.2.4",
    "size-limit": "^11.1.6",
    "storybook": "^8.6.17",
    "storybook-dark-mode": "^4.0.2",
    "tslib": "^2.7.0",
    "typescript": "^5.6.3",
    "typescript-plugin-css-modules": "^5.1.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.0",
    "@hugeicons/react": "1.1.10",
    "@tanstack/match-sorter-utils": "9.1.2",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/react-table": "9.1.2",
    "@tanstack/react-virtual": "3.14.9"
  },
  "peerDependencies": {
    "@mantine/core": ">=9.0.0-alpha.0",
    "@mantine/dates": ">=9.0.0-alpha.0",
    "@mantine/hooks": ">=9.0.0-alpha.0",
    "clsx": ">=2",
    "dayjs": ">=1.11",
    "react": ">=18.0",
    "react-dom": ">=18.0"
  }
}
